# Copy to .env and adjust. Never commit .env.

# PostgreSQL (used by the db container)
POSTGRES_USER=tally
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tally

# Backend
DATABASE_URL=postgresql+psycopg://tally:change-me@db:5432/tally
EXTRACTOR=stub
UPLOAD_DIR=/data/uploads

# Host port for the API container (change if 8000 is taken by another project)
API_PORT=8000
