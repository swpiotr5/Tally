# Copy to .env and adjust. Never commit .env.

# PostgreSQL (used by the db container)
POSTGRES_USER=tally
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tally

# Backend
DATABASE_URL=postgresql+psycopg://tally:change-me@db:5432/tally
UPLOAD_DIR=/data/uploads

# Receipt extraction: "stub" (fake data, no API key) or "vision" (Claude reads the photo)
EXTRACTOR=stub
ANTHROPIC_API_KEY=
VISION_MODEL=claude-haiku-5-5
VISION_EFFORT=medium
VISION_MAX_IMAGE_SIDE=1568

# Host ports (change if taken by another project)
API_PORT=8000
FRONTEND_PORT=5173
